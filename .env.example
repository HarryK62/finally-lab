# FinAlly environment configuration.
#
# Copy this file to `.env` in the project root and fill in what you need:
#
#     cp .env.example .env          # macOS / Linux
#     Copy-Item .env.example .env   # Windows PowerShell
#
# `.env` is gitignored and is never baked into the Docker image; it is passed
# to the container at run time via `--env-file .env` / compose `env_file`.
# Every variable below is optional — with an empty file the app still runs on
# the built-in market simulator.

# Required for the AI chat panel: your OpenRouter API key.
# Get one at https://openrouter.ai/keys. Leave empty and set LLM_MOCK=true to
# run the chat with deterministic canned responses instead.
OPENROUTER_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data.
# Set and non-empty -> the backend polls the Massive REST API.
# Empty or unset    -> the built-in simulator is used (recommended).
MASSIVE_API_KEY=

# Optional: "true" or "1" makes the chat return deterministic mock responses
# with no network calls and no API key. Used by the E2E tests.
LLM_MOCK=false

# Optional: how many days of portfolio-value snapshots to keep. One row is
# written every 30s plus one per trade, in a volume that survives restarts, so
# the table grows without bound if nothing prunes it. Set 0 to keep everything.
# Default: 7. The most recent 500 rows always survive, so the P&L chart cannot
# be emptied by pruning.
SNAPSHOT_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Advanced. The defaults are correct both for local development and inside the
# container; only set these if you are relocating files deliberately.
#
# Where the SQLite database lives.
#   local Docker default: /app/db/finally.db  (the finally-data volume)
#   local dev default:    <repo root>/db/finally.db
# DB_PATH=
#
# Where the built frontend is served from.
#   Docker default:    /app/backend/static
#   local dev default: <repo root>/backend/static
# STATIC_DIR=
